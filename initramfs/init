#!/bin/sh
# zboot: boot stage for ztOS's phones (Galaxy S9 "starlte", Galaxy M20
# "m20lte") on a mainline kernel. Nothing here is specific to one phone: the
# root is found by its label, and the phone names itself from its device tree.
#
# Phase covered here: rescue shell (M1) and Arch Linux ARM from the internal
# UFS (M4). The postmarketOS entry and the on-screen menu come later.
#
# Kernel command line:
#   zboot.rescue=1     do not boot anything, stay in the rescue shell
#   zboot.deadman=N    reset the phone N seconds after boot unless
#                      /run/zboot.hold exists (0 = never). The fallback boot
#                      target armed by the kernel is TWRP, so an unattended
#                      test always ends somewhere adb can reach.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

/bin/busybox --install -s /bin 2>/dev/null
mkdir -p /proc /sys /dev /run /tmp /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs -o mode=755 tmpfs /run
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null

echo 1 > /proc/sys/kernel/sysrq

# the phone, as its device tree names it: "Samsung Galaxy M20", "m20lte"
MODEL=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)
DEVICE=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | head -n1 | cut -d, -f2)

LOG=/run/zboot.log
log() {
	echo "zboot| $*" > /dev/kmsg 2>/dev/null
	echo "$(cut -d' ' -f1 /proc/uptime) $*" >> "$LOG"
}

arg() {
	sed -n "s/.*\b$1=\([^ ]*\).*/\1/p" /proc/cmdline
}

# With zboot.savelog=1, this boot's log is kept on the phone's CACHE partition
# (ext4, for Android's temporary files: nothing of the user's), as
# /cache/ztos/boot-N.log, readable from TWRP/OrangeFox afterwards. For bring-up
# on a phone that has no working USB yet.
save_log() {
	[ "$(arg zboot.savelog)" = 1 ] || return 0
	dev=
	for u in /sys/class/block/*/uevent; do
		grep -qx 'PARTNAME=CACHE' "$u" 2>/dev/null || continue
		dev=/dev/$(sed -n 's/^DEVNAME=//p' "$u")
		break
	done
	[ -b "$dev" ] || { log "savelog: no CACHE partition"; return 1; }
	mkdir -p /run/cache
	mount -t ext4 -o rw,noatime "$dev" /run/cache 2>/dev/null || { log "savelog: $dev is not ext4"; return 1; }
	mkdir -p /run/cache/ztos
	n=$(ls /run/cache/ztos 2>/dev/null | wc -l)
	f=/run/cache/ztos/boot-$((n + 1)).log
	{
		echo "== $* (uptime $(cut -d' ' -f1 /proc/uptime) s)"
		echo "== cmdline: $(cat /proc/cmdline)"
		echo "== cpus online: $(cat /sys/devices/system/cpu/online)"
		echo "== zboot.log"; cat "$LOG" 2>/dev/null
		echo "== block devices"; ls /sys/class/block 2>/dev/null | tr '\n' ' '; echo
		echo "== udc: $(ls /sys/class/udc 2>/dev/null)"
		# zboot.regor=ADDR:BITS,...: OR bits into registers first (to ungate
		# a block's clock so its registers can be read), then
		# zboot.regdump=ADDR,ADDR,...: 32-bit registers, for bring-up
		for ab in $(arg zboot.regor | tr ',' ' '); do
			a=${ab%%:*} b=${ab#*:}
			v=$(devmem "$a" 32 2>/dev/null) || continue
			devmem "$a" 32 $((v | b)) 2>/dev/null
			echo "== regor $a: $v | $b -> $(devmem "$a" 32 2>&1)"
		done
		for a in $(arg zboot.regdump | tr ',' ' '); do
			echo "== reg $a = $(devmem "$a" 32 2>&1)"
		done
		echo "== dmesg"; dmesg
	} > "$f" 2>&1
	sync
	umount /run/cache
	log "savelog: $f on $dev"
}

log "===== zboot on $(uname -r), $(cat /proc/device-tree/model 2>/dev/null) ====="
log "cpus online: $(cat /sys/devices/system/cpu/online)  mem: $(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo)"

# --- deadman ------------------------------------------------------------------
# sysrq-b skips the reboot notifiers, so the fallback target the kernel armed in
# INFORM3 stays in place. The subshell survives switch_root; the moved procfs is
# then reachable under /newroot from its point of view.
DEADMAN=$(arg zboot.deadman)
DEADMAN=${DEADMAN:-600}
EARLY_DEADMAN=
if [ "$DEADMAN" -gt 0 ] 2>/dev/null; then
	log "deadman: reset in $DEADMAN s unless /run/zboot.hold exists"
	# One sleep per deadman, and nothing but shell builtins afterwards: once
	# switch_root has replaced this root, /bin/sleep is gone and any applet
	# would have to be exec'd from a filesystem that no longer exists.
	(
		sleep "$DEADMAN"
		[ -e /run/zboot.hold ] && exit 0
		echo "zboot| deadman fired in the boot stage" > /dev/kmsg 2>/dev/null
		save_log "deadman fired in the boot stage"
		echo b > /proc/sysrq-trigger 2>/dev/null
	) &
	EARLY_DEADMAN=$!
fi

# The same timer for the system we hand over to. It runs with its working
# directory inside the root being switched to, so its relative paths follow
# that directory when it becomes "/" and keep working after the handover.
late_deadman() {
	[ -n "$EARLY_DEADMAN" ] || return 0
	kill "$EARLY_DEADMAN" 2>/dev/null
	(
		cd /newroot || exit 0
		sleep "$DEADMAN"
		[ -e run/zboot.hold ] && exit 0
		echo "zboot| deadman fired after handover" > dev/kmsg 2>/dev/null
		echo b > proc/sysrq-trigger 2>/dev/null
	) &
	log "deadman re-armed for the new root: touch /run/zboot.hold within $DEADMAN s"
}

# --- USB: NCM network + ACM serial, telnet on 172.16.42.1 ----------------------
usb_up() {
	mount -t configfs none /sys/kernel/config 2>/dev/null
	g=/sys/kernel/config/usb_gadget/zboot
	[ -d "$g" ] && return 0
	i=0
	while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ "$i" -lt 40 ]; do
		i=$((i + 1))
		sleep 0.25
	done
	udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
	if [ -z "$udc" ]; then
		log "usb: no UDC"
		return 1
	fi
	mkdir -p "$g" || return 1
	echo 0x1d6b > "$g/idVendor"
	echo 0x0104 > "$g/idProduct"
	mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
	echo "zboot" > "$g/strings/0x409/manufacturer"
	echo "${MODEL:-phone} zboot rescue" > "$g/strings/0x409/product"
	echo "${DEVICE:-zboot}" > "$g/strings/0x409/serialnumber"
	echo "ncm+acm" > "$g/configs/c.1/strings/0x409/configuration"
	mkdir -p "$g/functions/ncm.usb0" "$g/functions/acm.GS0"
	echo 02:5a:42:00:00:01 > "$g/functions/ncm.usb0/dev_addr"
	echo 02:5a:42:00:00:02 > "$g/functions/ncm.usb0/host_addr"
	ln -s "$g/functions/ncm.usb0" "$g/configs/c.1/"
	ln -s "$g/functions/acm.GS0" "$g/configs/c.1/"
	echo "$udc" > "$g/UDC" || { log "usb: binding $udc failed"; return 1; }
	ifconfig lo 127.0.0.1 up
	ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
	# no router and no DNS option: the host must not route anything this way
	mkdir -p /var/lib/misc /etc
	: > /var/lib/misc/udhcpd.leases
	cat > /etc/udhcpd.conf <<-EOF
		start 172.16.42.2
		end 172.16.42.2
		interface usb0
		max_leases 1
		option subnet 255.255.255.0
		option lease 3600
	EOF
	udhcpd /etc/udhcpd.conf
	telnetd -l /bin/sh -p 23
	log "usb: $udc bound, telnet on 172.16.42.1"
}

rescue() {
	log "rescue shell: $*"
	touch /run/zboot.hold 2>/dev/null
	usb_up
	cp "$LOG" /run/zboot.rescue 2>/dev/null
	save_log "rescue shell: $*"
	# zboot.rescue_timeout=N: leave the rescue shell after N seconds, through a
	# reset that keeps the fallback target (TWRP), for a phone nobody can reach
	RT=$(arg zboot.rescue_timeout)
	if [ "${RT:-0}" -gt 0 ] 2>/dev/null; then
		log "rescue: resetting in $RT s (zboot.rescue_timeout)"
		(
			sleep "$RT"
			save_log "rescue timeout"
			echo b > /proc/sysrq-trigger 2>/dev/null
		) &
	fi
	while :; do
		setsid sh -c 'exec sh -i </dev/tty0 >/dev/tty0 2>&1'
		sleep 1
	done
}

# Bring USB up before anything that may fail: it is the way in.
usb_up

[ "$(arg zboot.rescue)" = 1 ] && rescue "requested on the command line"

# --- find and boot the Arch root ----------------------------------------------
i=0
ROOTDEV=
while [ "$i" -lt 12 ]; do
	ROOTDEV=$(findfs LABEL=ZR_ARCH 2>/dev/null) && [ -n "$ROOTDEV" ] && break
	i=$((i + 1))
	sleep 0.25
done
log "block devices after $i tries: $(echo $(ls /sys/class/block 2>/dev/null | grep -v '^ram\|^loop' | tr '\n' ' '))"
[ -n "$ROOTDEV" ] || rescue "no filesystem labelled ZR_ARCH"

log "ZR_ARCH is $ROOTDEV"
mount -t ext4 -o ro "$ROOTDEV" /newroot || rescue "mount of $ROOTDEV failed"
[ -x /newroot/sbin/init ] || [ -L /newroot/sbin/init ] || {
	umount /newroot
	rescue "no /sbin/init on ZR_ARCH"
}

# The gadget goes with the initramfs: the root system builds its own.
if [ -d /sys/kernel/config/usb_gadget/zboot ]; then
	killall telnetd udhcpd 2>/dev/null
	g=/sys/kernel/config/usb_gadget/zboot
	echo "" > "$g/UDC" 2>/dev/null
	rm -f "$g/configs/c.1/ncm.usb0" "$g/configs/c.1/acm.GS0"
	rmdir "$g/configs/c.1/strings/0x409" "$g/configs/c.1" \
		"$g/functions/ncm.usb0" "$g/functions/acm.GS0" \
		"$g/strings/0x409" "$g" 2>/dev/null
fi

log "switch_root to $ROOTDEV"
dmesg > /run/zboot.dmesg 2>/dev/null
late_deadman
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
mount --move /run /newroot/run
exec switch_root /newroot /sbin/init

echo "zboot| switch_root failed" > /dev/kmsg
exec sh -i </dev/console >/dev/console 2>&1
