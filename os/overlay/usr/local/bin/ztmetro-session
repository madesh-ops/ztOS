#!/bin/sh
# What greetd starts: the ztMETRO session, the only one ztOS has. The log is
# kept for one run back.
[ -f /etc/ztos/session.env ] && . /etc/ztos/session.env

# Apps that D-Bus or systemd start for the session (GNOME Maps, Calendar,
# Weather and Clocks run as D-Bus services) are children of systemd --user,
# not of ztmetro: give them the same graphics and malloc settings, or they
# load the stock Mesa and GTK's text and icons come out faded and blurred.
# A variable session.env left unset (the M20 Mesa's fallback) is unset there
# too, so a bad start isn't carried into the next.
sv=; uv=
for v in LD_LIBRARY_PATH PAN_MESA_DEBUG GLIBC_TUNABLES; do
	if eval "[ -n \"\${$v+x}\" ]"; then sv="$sv $v"; else uv="$uv $v"; fi
done
[ -n "$uv" ] && timeout 5 systemctl --user unset-environment $uv
[ -n "$sv" ] && timeout 5 dbus-update-activation-environment --systemd $sv
unset sv uv v
state=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$state/ztos"
log=$state/ztmetro.log
[ -f "$log" ] && mv "$log" "$log.1"
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# The warm runtime of SDK apps (Qt loaded once, apps forked from it), up
# before the first tap: no app waits for Qt to load.
z=$HOME/.local/share/ztos/zygote.py
if [ -f "$z" ]; then
	(sleep 3; XDG_RUNTIME_DIR=$runtime setsid python3 -I "$z" > "$state/ztos/zygote.log" 2>&1 < /dev/null &) &
fi

# The first time: the welcome, once Start is up.
welcome=/usr/local/lib/ztos/apps/os.ztos.welcome
if [ ! -f "$HOME/.config/ztos/welcomed" ] && [ -x "$welcome" ]; then
	(sleep 5; [ -p "$runtime/ztmetro.ctl" ] && printf 'launch %s\n' "$welcome" > "$runtime/ztmetro.ctl") &
fi

exec /usr/local/bin/ztmetro > "$log" 2>&1
