# ztOS on the Galaxy M20: a 1080 x 2340 screen, 3 pixels a point (the S9:
# 1440 wide at 4, so both are 360 points across). The screen is the
# bootloader's framebuffer through simpledrm (/dev/dri/card0); the Mali-G71
# renders through Panfrost (renderD128), for ztMETRO and its apps alike:
# wlroots draws with it and scans out on simpledrm.
export ZTMETRO_SCALE=3
export WLR_NO_HARDWARE_CURSORS=1
# No AFBC (Arm's framebuffer compression) on this first-revision G71 (r0p0):
# with it, Firefox's cached page tiles came out with 16x16 blocks of black
# over the text; without it they render clean (screenshots on the M20).
export PAN_MESA_DEBUG=noafbc
# GTK 4 and Firefox draw on the GPU: their anti-aliased text, corners and
# borders need screen-space derivatives, which this G71 cannot compute the
# usual way; devices/m20lte/mesa/ rebuilds Mesa to compute them another way.
# glibc in every app of the session: fixed mmap and trim thresholds. By
# default glibc raises its mmap threshold each time a big block is freed, so
# later big blocks (pictures, decoded images) come from the heap, which keeps
# what they leave: ztMETRO held 48 MB of freed heap that way. Fixed, big
# blocks are mapped apart and given back when freed.
export GLIBC_TUNABLES=glibc.malloc.mmap_threshold=262144:glibc.malloc.trim_threshold=1048576
# Superscan renders pages at 2 pixels a point, the shell scales them up: at
# the screen's 3 the Mali-G71 MP2 sat at its top clock and scrolling lagged.
export ZTB_MAX_SCALE=2
# ...and drags move the live page, never a picture of the whole document:
# taking one held the page up, and fading back from it showed black.
export ZTB_NO_PICTURE=1
# Page tiles without multisampling: less for the Mali-G71 MP2 to do.
export WEBKIT_SKIA_MSAA_SAMPLE_COUNT=0
