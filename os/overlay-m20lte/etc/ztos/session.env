# ztOS on the Galaxy M20: a 1080 x 2340 screen, 3 pixels a point (the S9:
# 1440 wide at 4, so both are 360 points across). The screen is the
# bootloader's framebuffer through simpledrm (/dev/dri/card0); the Mali-G71
# renders through Panfrost (renderD128), for ztMETRO and its apps alike:
# wlroots draws with it and scans out on simpledrm.
export ZTMETRO_SCALE=3
export WLR_NO_HARDWARE_CURSORS=1
# No AFBC (Arm's framebuffer compression) on this first-revision G71 (r0p0):
# with it, Firefox's cached page tiles came out with 16x16 blocks of black
# over the text; without it they render clean (screenshots on the M20).
export PAN_MESA_DEBUG=noafbc
# GTK 4 and Firefox draw on the GPU: their anti-aliased text, corners and
# borders need screen-space derivatives, which this G71 cannot compute the
# usual way; devices/m20lte/mesa/ rebuilds Mesa to compute them another way.
# glibc in every app of the session: fixed mmap and trim thresholds. By
# default glibc raises its mmap threshold each time a big block is freed, so
# later big blocks (pictures, decoded images) come from the heap, which keeps
# what they leave: ztMETRO held 48 MB of freed heap that way. Fixed, big
# blocks are mapped apart and given back when freed.
export GLIBC_TUNABLES=glibc.malloc.mmap_threshold=262144:glibc.malloc.trim_threshold=1048576
# The M20's patched libgallium (devices/m20lte/mesa: the G71's derivatives),
# for the shell and every app it starts, from its own folder: Arch's library
# in /usr/lib stays as it is.
#
# A guard against a Mesa that freezes the phone: each start writes a pending
# mark with this boot's id and clears it after 90 s. A mark from this same
# boot means the session was only restarted (greetd, a crash, a test), not a
# freeze, so it's ignored. A mark from an earlier boot means the phone was
# restarted within 90 s of a start: a counted failure. After 2 in a row Arch's
# library is used until the patched one is rebuilt (its mtime changes) or
# mesa-m20.fails is removed; one good start clears the count. The patched
# library is only used while it matches Arch's Mesa version (libEGL_mesa
# loads libgallium by its versioned name).
_m20mesa=/usr/lib/ztos-mesa-m20
_m20st=${XDG_STATE_HOME:-$HOME/.local/state}/ztos
_m20log=$_m20st/mesa-m20.log
_m20lib=$(cd "$_m20mesa" 2>/dev/null && ls libgallium-*.so 2>/dev/null | head -n 1)
if [ -n "$_m20lib" ]; then
	mkdir -p "$_m20st"
	_m20boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
	_m20ver=$(stat -c %Y "$_m20mesa/$_m20lib")
	_m20n=0
	if [ -f "$_m20st/mesa-m20.fails" ]; then
		read -r _m20fver _m20n < "$_m20st/mesa-m20.fails"
		[ "$_m20fver" = "$_m20ver" ] || _m20n=0	# rebuilt since: try it again
	fi
	if [ -f "$_m20st/mesa-m20.pending" ]; then
		read -r _m20pboot < "$_m20st/mesa-m20.pending"
		if [ "$_m20pboot" != "$_m20boot" ]; then
			_m20n=$((_m20n + 1))
			echo "$(date) mesa-m20: the phone restarted within 90 s of a start ($_m20n in a row)" >> "$_m20log"
			echo "$_m20ver $_m20n" > "$_m20st/mesa-m20.fails"
		fi
		rm -f "$_m20st/mesa-m20.pending"
	fi
	if [ ! -f "/usr/lib/$_m20lib" ]; then
		echo "$(date) mesa-m20: Arch's Mesa is no longer $_m20lib; rebuild devices/m20lte/mesa. Arch's Mesa this time" >> "$_m20log"
	elif [ "$_m20n" -ge 2 ]; then
		echo "$(date) mesa-m20: $_m20n failed starts in a row; Arch's Mesa until rebuilt or mesa-m20.fails is removed" >> "$_m20log"
	else
		echo "$_m20boot" > "$_m20st/mesa-m20.pending"; sync
		export LD_LIBRARY_PATH="$_m20mesa${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
		(sleep 90; rm -f "$_m20st/mesa-m20.pending" "$_m20st/mesa-m20.fails") > /dev/null 2>&1 &
	fi
	unset _m20boot _m20ver _m20n _m20fver _m20pboot
fi
unset _m20mesa _m20st _m20log _m20lib
