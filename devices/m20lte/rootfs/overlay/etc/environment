#
# This file is parsed by pam_env module
#
# Syntax: simple "KEY=VAL" pairs on separate lines
#

# No proxy: the phone has Wi-Fi. The USB tunnel's SOCKS proxy
# (scripts/usb-internet.sh) is opt-in: export all_proxy=socks5h://127.0.0.1:1080
# in the shell that needs it.

# No screen reader: GTK need not look for the accessibility bus (masked, see
# the installer), which otherwise stays running at ~27 MB
GTK_A11Y=none
NO_AT_BRIDGE=1
