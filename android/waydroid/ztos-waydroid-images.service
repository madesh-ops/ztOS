[Unit]
Description=ztOS: put the stripped Android (Waydroid) in place
Documentation=file:///usr/share/ztos-waydroid/README.md
Wants=network-online.target
After=network-online.target
# (no ConditionPathExists on the ready mark: the script itself returns at
# once when Android is ready AND installed, and finishes an install.sh that
# a first boot left undone, as on the M20)

[Service]
Type=oneshot
ExecStart=/usr/lib/ztos/ztos-waydroid-images
# no network yet, or a download cut: try again later, never in a loop
Restart=on-failure
RestartSec=10min
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
